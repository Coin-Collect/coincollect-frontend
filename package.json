{
  "name": "coincollect-project",
  "version": "2.5.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "analyze": "ANALYZE=true yarn build",
    "dev": "next dev --webpack",
    "fork:install": "npm install --prefix scripts/local-fork-tool --no-audit --no-fund",
    "fork:start": "node scripts/local-fork-tool/main.cjs start",
    "fork:seed": "node scripts/local-fork-tool/main.cjs seed",
    "fork:status": "node scripts/local-fork-tool/main.cjs status",
    "fork:advance": "node scripts/local-fork-tool/main.cjs advance",
    "fork:reset": "node scripts/local-fork-tool/main.cjs reset",
    "dev:fork": "node scripts/local-fork-tool/main.cjs dev",
    "test:fork": "node scripts/local-fork-tool/main.cjs test",
    "build": "next build --webpack",
    "start": "next start",
    "test": "jest",
    "typecheck:v3": "tsc -p tsconfig.v3.json",
    "typecheck:workspaces": "tsc -p packages/coincollect-sdk --incremental false && tsc -p packages/uikit --incremental false && tsc -p packages/uikit/tsconfig.storybook.json --incremental false",
    "test:config": "jest src/config/__tests__/",
    "integration-test": "start-server-and-test start http://localhost:3000 'cypress run'",
    "lint:v3": "eslint --ext .js,.ts,.tsx src/features/universalRewards src/pages/api/v3 src/pages/nftpools/v3 src/pages/admin/nft-pools/v3.tsx",
    "lint": "eslint src packages",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx}\"",
    "format:check:staged": "lint-staged",
    "format:write": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "updateLPsAPR": "NODE_PATH=./src ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/updateLPsAPR.ts",
    "prepare": "husky install",
    "postinstall": "yarn run typechain",
    "typechain": "typechain --out-dir src/config/abi/types --target=ethers-v5 \"src/config/abi/*.json\"",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@binance-chain/bsc-connector": "^1.0.0",
    "@ethersproject/abi": "^5.0.0",
    "@ethersproject/address": "^5.0.0",
    "@ethersproject/bignumber": "^5.0.0",
    "@ethersproject/bytes": "^5.0.0",
    "@ethersproject/constants": "^5.0.0",
    "@ethersproject/contracts": "^5.0.0",
    "@ethersproject/experimental": "^5.0.0",
    "@ethersproject/providers": "^5.0.0",
    "@ethersproject/strings": "^5.0.0",
    "@ethersproject/units": "^5.0.0",
    "@next/bundle-analyzer": "16.4.6",
    "@reduxjs/toolkit": "^1.9.1",
    "@sentry/nextjs": "11.16.0",
    "@tanstack/react-query": "^5.52.2",
    "@typechain/ethers-v5": "^11.1.2",
    "@uniswap/token-lists": "1.0.0-beta.34",
    "@web3-react/injected-connector": "^6.0.7",
    "@web3-react/walletlink-connector": "^6.2.13",
    "@web3modal/wagmi": "^5.1.4",
    "ajv": "^6.12.3",
    "bignumber.js": "^9.0.0",
    "canvas-confetti": "^1.3.3",
    "cids": "^1.0.0",
    "date-fns": "^2.21.3",
    "easymde": "^2.15.0",
    "fast-json-stable-stringify": "^2.1.0",
    "graphql": "^15.5.0",
    "graphql-request": "^3.4.0",
    "js-cookie": "3.0.7",
    "lightweight-charts": "^3.5.0",
    "lint-staged": "^12.3.4",
    "lodash": "4.18.1",
    "multicodec": "^2.0.0",
    "multihashes": "^3.0.1",
    "next": "16.4.6",
    "numeral": "^2.0.6",
    "react": "18.3.1",
    "react-countup": "^6.4.0",
    "react-datepicker": "^4.8.0",
    "react-dom": "18.3.1",
    "react-markdown": "^6.0.2",
    "react-redux": "^8.0.5",
    "react-transition-group": "^4.4.5",
    "react-window": "^1.8.7",
    "recharts": "^2.1.15",
    "redux-persist": "^6.0.0",
    "remark-gfm": "^1.0.0",
    "sharp": "0.35.5",
    "split-grid": "^1.0.11",
    "styled-components": "^5.3.0",
    "swiper": "12.2.0",
    "swr": "^1.1.2",
    "typescript": "5.9.3",
    "viem": "^2.20.1",
    "wagmi": "^2.12.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^13.1.0",
    "@commitlint/config-conventional": "^13.1.0",
    "@testing-library/react-hooks": "^7.0.2",
    "@types/canvas-confetti": "^1.4.2",
    "@types/jest": "^26.0.23",
    "@types/js-cookie": "^3.0.1",
    "@types/lodash": "^4.14.178",
    "@types/multicodec": "^1.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-datepicker": "^3.1.8",
    "@types/react-dom": "^18.3.0",
    "@types/react-redux": "^7.1.16",
    "@types/react-transition-group": "^4.4.1",
    "@types/react-window": "^1.8.3",
    "@types/simplemde": "^1.11.7",
    "@types/styled-components": "^5.1.7",
    "cypress": "8.3.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-cypress": "^2.11.3",
    "eslint-plugin-lodash": "^7.4.0",
    "husky": "^7.0.0",
    "jest": "^27.4.5",
    "prettier": "^2.3.0",
    "serve": "^13.0.2",
    "source-map-explorer": "^2.5.2",
    "start-server-and-test": "^1.14.0",
    "ts-node": "^9.1.1",
    "turbo": "^1.13.4",
    "typechain": "^8.3.2"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "elliptic": "6.6.1",
    "lodash": "4.18.1",
    "**/@ethersproject/providers/ws": "8.23.0",
    "**/axios/form-data": "4.0.6",
    "**/@cypress/request/form-data": "2.5.6",
    "**/@wagmi/connectors/@coinbase/wallet-sdk": "4.3.0",
    "**/eciesjs/secp256k1": "5.0.2",
    "**/viem/ws": "8.23.0",
    "**/engine.io-client/ws": "8.23.0",
    "**/graphql-request/form-data": "3.0.5",
    "**/@web3modal/base/bs58/base-x": "4.0.1",
    "**/listhen/node-forge": "1.4.3",
    "**/unstorage/h3": "1.15.6",
    "**/listhen/h3": "1.15.6",
    "**/h3/defu": "6.1.7",
    "**/socket.io-client/socket.io-parser": "4.2.7",
    "**/ajv/fast-uri": "3.1.9",
    "**/micromatch/picomatch": "2.3.2",
    "**/webpack-bundle-analyzer/ws": "7.5.14",
    "**/@walletconnect/jsonrpc-ws-connection/ws": "7.5.14",
    "**/jsdom/ws": "7.5.14",
    "**/query-string/decode-uri-component": "file:vendor/decode-uri-component",
    "**/anymatch/picomatch": "2.3.2",
    "**/readdirp/picomatch": "2.3.2",
    "**/jest-util/picomatch": "2.3.2"
  }
}
